# Firebase web config (Firebase console > Project settings > Your apps).
# These values are public identifiers, not secrets: access is enforced by
# firestore.rules and Firebase Auth. Restrict the API key to your domains.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
